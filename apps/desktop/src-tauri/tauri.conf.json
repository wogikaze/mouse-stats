{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mouse Stats",
  "version": "0.1.0",
  "identifier": "dev.wgkz.mouse-stats",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mouse Stats",
        "width": 1200,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] },
  "plugins": { "deep-link": { "desktop": { "schemes": ["mousestats"] } } }
}
